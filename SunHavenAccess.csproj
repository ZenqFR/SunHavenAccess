<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SunHavenAccess</AssemblyName>
    <RootNamespace>SunHavenAccess</RootNamespace>
    <Description>Mod d'accessibilite pour Sun Haven - lecteur d'ecran (Tolk/CrossSpeak)</Description>
    <!-- Le jeu et BepInEx fournissent déjà toutes ces DLL à l'exécution -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Chemins vers l'installation du jeu : ajuste GameDir si besoin -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Sun Haven</GameDir>
    <ManagedDir>$(GameDir)\Sun Haven_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <PluginOutDir>$(GameDir)\BepInEx\plugins\SunHavenAccess</PluginOutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.GridModule">
      <HintPath>$(ManagedDir)\UnityEngine.GridModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TilemapModule">
      <HintPath>$(ManagedDir)\UnityEngine.TilemapModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Sun Haven -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SunHaven.Core">
      <HintPath>$(ManagedDir)\SunHaven.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SunHaven.External">
      <HintPath>$(ManagedDir)\SunHaven.External.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>$(ManagedDir)\Sirenix.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(ManagedDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="QFSW.QC">
      <HintPath>$(ManagedDir)\QFSW.QC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="I2Localization">
      <HintPath>$(ManagedDir)\I2Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Synthèse vocale : NVDA en direct (nvdaControllerClient64.dll) + SAPI de secours via
         le pilote natif de Tolk.dll (P/Invoke pur, voir Speech/TolkSpeech.cs).
         Volontairement AUCUNE référence à System.Speech ni activation COM managée : le
         runtime Mono embarqué par Unity ne supporte ni l'une ni l'autre (plantage silencieux
         du chargement du mod pour la première, NotImplementedException pour la seconde). -->
  </ItemGroup>

  <ItemGroup>
    <!-- Binaires natifs, à copier tels quels à côté de la DLL du plugin -->
    <None Include="lib\nvdaControllerClient64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>nvdaControllerClient64.dll</Link>
    </None>
    <None Include="lib\Tolk.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Tolk.dll</Link>
    </None>
  </ItemGroup>

  <!-- Déploiement direct dans BepInEx/plugins pour itérer vite -->
  <Target Name="DeployToGame" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)SunHavenAccess.dll" />
      <DeployFiles Include="$(OutDir)nvdaControllerClient64.dll" />
      <DeployFiles Include="$(OutDir)Tolk.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PluginOutDir)" Condition="!Exists('$(PluginOutDir)')" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
